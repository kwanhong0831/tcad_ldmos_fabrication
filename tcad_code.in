1번째


go athena

# ============================================================
# Part 1. Well Formation
# Purpose:
#   Make p-well and n-well for LOCOS-based nLDMOS.
#   Mesh is refined near source / NLDD / gate edge.
# Output:
#   ldmos_01_well_fix.str
# ============================================================

# ------------------------------------------------------------
# Mesh
# ------------------------------------------------------------
line x loc=0.00  spac=0.10
line x loc=0.55  spac=0.04
line x loc=0.75  spac=0.025
line x loc=1.20  spac=0.020
line x loc=1.40  spac=0.015
line x loc=1.45  spac=0.015
line x loc=1.60  spac=0.015
line x loc=1.80  spac=0.015
line x loc=1.95  spac=0.010
line x loc=2.10  spac=0.015
line x loc=2.80  spac=0.025
line x loc=3.05  spac=0.020
line x loc=3.20  spac=0.020
line x loc=3.80  spac=0.020
line x loc=4.30  spac=0.020
line x loc=5.00  spac=0.030
line x loc=8.00  spac=0.070
line x loc=9.35  spac=0.030
line x loc=10.05 spac=0.030
line x loc=10.50 spac=0.040
line x loc=11.00 spac=0.080

line y loc=0.00  spac=0.015
line y loc=0.05  spac=0.015
line y loc=0.10  spac=0.020
line y loc=0.20  spac=0.040
line y loc=0.50  spac=0.060
line y loc=0.80  spac=0.080
line y loc=1.50  spac=0.150
line y loc=3.00  spac=0.300
line y loc=5.00  spac=0.500

# ------------------------------------------------------------
# Initial p-type silicon
# Paper:
#   Boron substrate
#   Nsub = 5e14 cm-3
#   Orientation = <100>
# ------------------------------------------------------------
init silicon c.boron=5.0e14 orientation=100 two.d

structure outfile=ldmos_00_initial.str

# ------------------------------------------------------------
# N-well implant
# Paper:
#   Dry O2: 950 C, 40 min
#   Phosphorus: 1.3e13 cm-2, 150 keV, tilt 7 deg
#
# Mask calibration:
#   N-well starts at x=2.80 um.
#   This helps N-well remain below the left LOCOS bird's beak.
# ------------------------------------------------------------
diffus time=40 temp=950 dryo2 press=1.0

deposit photoresist thick=1.20

etch photoresist start x=2.80 y=-2.00
etch cont          x=11.00 y=-2.00
etch cont          x=11.00 y=0.80
etch done          x=2.80 y=0.80

implant phosphor dose=1.3e13 energy=150 tilt=7 pearson

strip photoresist
etch oxide all

structure outfile=ldmos_01_nwell_implant.str

# ------------------------------------------------------------
# P-well implant
# Paper:
#   Boron: 3.7e13 cm-2, 160 keV
#
# Mask calibration:
#   P-well ends at x=3.05 um.
#   This prevents p-well from moving too far under LOCOS.
# ------------------------------------------------------------
diffus time=40 temp=950 dryo2 press=1.0

deposit photoresist thick=1.20

etch photoresist start x=0.00 y=-2.00
etch cont          x=3.05 y=-2.00
etch cont          x=3.05 y=0.80
etch done          x=0.00 y=0.80

implant boron dose=3.7e13 energy=160 tilt=7 pearson

strip photoresist
etch oxide all

structure outfile=ldmos_02_pwell_implant.str

# ------------------------------------------------------------
# Well drive-in
# Paper:
#   1150 C, 120 min, N2
# ------------------------------------------------------------
diffus time=120 temp=1150 nitrogen

structure outfile=ldmos_01_well_fix.str

tonyplot ldmos_01_well_fix.str

quit
















2번째


go athena

# ============================================================
# Part 2. LOCOS Formation
# Target:
#   LOCOS thick oxide on N-well drift region
#   Left bird's beak around x = 3.8 ~ 4.4 um
#   Final LOCOS thickness close to paper value: 787.4 nm
# ============================================================

init infile=ldmos_01_well_fix.str

method compress

# ------------------------------------------------------------
# Pad oxide
# Paper:
#   Dry O2, 950 C, 20 min
# ------------------------------------------------------------
diffus time=20 temp=950 dryo2 press=1.0

structure outfile=ldmos_02_01_pad_oxide.str

# ------------------------------------------------------------
# Nitride mask
# Paper:
#   Nitride thickness = 150 nm
# ------------------------------------------------------------
deposit nitride thick=0.15

structure outfile=ldmos_02_02_nitride.str

# ------------------------------------------------------------
# LOCOS mask open
#
# Important:
#   The opening starts at x=4.35.
#   The actual bird's beak grows laterally to the left,
#   so the left bird's beak appears near x=3.8~4.2.
# ------------------------------------------------------------
deposit photoresist thick=1.20

etch photoresist start x=4.35 y=-2.00
etch cont          x=9.35 y=-2.00
etch cont          x=9.35 y=0.80
etch done          x=4.35 y=0.80

etch nitride start x=4.35 y=-1.00
etch cont       x=9.35 y=-1.00
etch cont       x=9.35 y=0.80
etch done       x=4.35 y=0.80

strip photoresist

structure outfile=ldmos_02_03_nitride_open.str

# ------------------------------------------------------------
# LOCOS wet oxidation
# Paper:
#   Wet H2O oxidation, 960 C, 240 min
#
# Run in 3 steps to create checkpoint files.
# ------------------------------------------------------------
diffus time=80 temp=960 weto2 press=1.0
structure outfile=ldmos_02_04_locos_080min.str

diffus time=80 temp=960 weto2 press=1.0
structure outfile=ldmos_02_05_locos_160min.str

diffus time=80 temp=960 weto2 press=1.0
structure outfile=ldmos_02_06_locos_240min.str

# ------------------------------------------------------------
# Nitride strip and post-LOCOS oxide etch
# Paper:
#   Isotropic oxide etch = 0.2 um
# ------------------------------------------------------------
etch nitride all

etch oxide thick=0.20

structure outfile=ldmos_02_locos_fix.str

tonyplot ldmos_02_locos_fix.str

quit













3번째

go athena

# ============================================================
# Part 3. Vth Adjust, Gate Oxide, Poly Gate, LDD, Spacer
# Input:
#   ldmos_02_locos_fix.str
# Output:
#   ldmos_03_gate_ldd_fix_v3.str
# ============================================================

init infile=ldmos_02_locos_fix.str

# ------------------------------------------------------------
# Vth adjust implant
# Paper:
#   Boron: 2e12 cm-2, 25 keV, tilt 7 deg
# ------------------------------------------------------------
deposit photoresist thick=1.20

etch photoresist start x=1.45 y=-2.00
etch cont          x=3.45 y=-2.00
etch cont          x=3.45 y=0.80
etch done          x=1.45 y=0.80

implant boron dose=2.0e12 energy=25 tilt=7 pearson

strip photoresist

structure outfile=ldmos_03_01_vt_adjust_v3.str

# ------------------------------------------------------------
# Gate oxide
# Paper:
#   Dry O2, 900 C, 40 min
#   Final gate oxide about 15 nm
# ------------------------------------------------------------
etch oxide start x=0.00 y=-1.00
etch cont       x=3.60 y=-1.00
etch cont       x=3.60 y=0.50
etch done       x=0.00 y=0.50

method grid.ox=0.02

diffus time=40 temp=900 dryo2 press=1.0

structure outfile=ldmos_03_02_gate_oxide_v3.str

# ------------------------------------------------------------
# Polysilicon gate and field plate
# Paper:
#   Poly thickness = 0.5 um
#   Phosphorus concentration = 5e19 cm-3
#
# Target:
#   Poly starts near x=1.95 um.
#   Poly extends over LOCOS until x=8.00 um.
# ------------------------------------------------------------
deposit poly thick=0.50 c.phosphor=5.0e19

# Remove poly on left side
etch poly start x=0.00 y=-1.50
etch cont    x=1.95 y=-1.50
etch cont    x=1.95 y=0.90
etch done    x=0.00 y=0.90

# Remove poly on right side
etch poly start x=8.00 y=-1.50
etch cont    x=11.00 y=-1.50
etch cont    x=11.00 y=0.90
etch done    x=8.00 y=0.90

structure outfile=ldmos_03_03_poly_gate_v3.str

# ------------------------------------------------------------
# Boron LDD / compensation implant
# Paper:
#   Four boron implants, 1e12 cm-2 each, tilt 30 deg
#
# 2D approximation:
#   Use one masked implant.
#   Do not use blanket implant.
# ------------------------------------------------------------
deposit photoresist thick=1.20

etch photoresist start x=1.45 y=-2.00
etch cont          x=3.30 y=-2.00
etch cont          x=3.30 y=0.80
etch done          x=1.45 y=0.80

implant boron dose=1.0e12 energy=20 tilt=30 pearson

strip photoresist

structure outfile=ldmos_03_04_boron_ldd_v3.str

# ------------------------------------------------------------
# Arsenic NLDD / n-type extension
# Paper:
#   Arsenic dose = 1e15 cm-2, tilt 0 deg
#
# Target:
#   NLDD should remain between source N+ and poly gate.
#   Source N+ will be x=0.70~1.45 in Part 4.
#   Poly starts at x=1.95.
#   Therefore NLDD is opened at x=1.40~2.00.
# ------------------------------------------------------------
deposit photoresist thick=1.20

etch photoresist start x=1.25 y=-2.00
etch cont          x=2.00 y=-2.00
etch cont          x=2.00 y=0.80
etch done          x=1.25 y=0.80

implant arsenic dose=1.0e15 energy=40 tilt=0 pearson

strip photoresist

# Short LDD anneal
diffus time=1 temp=960 nitrogen

structure outfile=ldmos_03_05_nldd_v3.str

# ------------------------------------------------------------
# Spacer formation
# Paper:
#   Spacer around 150 nm
#
# Use oxide deposition and dry etch-back.
# ------------------------------------------------------------
deposit oxide thick=0.15

etch oxide dry thick=0.15

structure outfile=ldmos_03_gate_ldd_fix_v3.str

tonyplot ldmos_03_05_nldd_v3.str
tonyplot ldmos_03_gate_ldd_fix_v3.str

quit










4번째


go athena

# ============================================================
# Part 4. N+ Source/Drain and P+ Body
# Input:
#   ldmos_03_gate_ldd_fix_v3.str
# Output:
#   ldmos_final_figure2_clean_v4.str
#
# Purpose:
#   Add source/drain N+ and body P+ regions.
#   This version avoids thermal oxidation crash after spacer.
# ============================================================

init infile=ldmos_03_gate_ldd_fix_v3.str

# ------------------------------------------------------------
# Screen oxide before Source/Drain implant
#
# Paper:
#   Dry O2, 925 C, 20 min
#
# Practical ATHENA replacement:
#   Use thin deposited oxide instead of thermal oxidation.
#   This prevents mesh failure around LOCOS / poly / spacer.
# ------------------------------------------------------------
deposit oxide thick=0.02

structure outfile=ldmos_04_00_screen_oxide_v4.str

# ------------------------------------------------------------
# N+ Source / Drain implant
#
# Paper:
#   Arsenic dose = 5e15 cm-2
#   Energy = 60 keV
#   Pearson distribution
#
# Target:
#   Source N+ = x 0.70 ~ 1.45 um
#   NLDD tail remains between x 1.45 ~ 1.95 um
# ------------------------------------------------------------
deposit photoresist thick=1.20

# Source N+ window
etch photoresist start x=0.70 y=-2.00
etch cont          x=1.30 y=-2.00
etch cont          x=1.30 y=0.80
etch done          x=0.70 y=0.80

# Drain N+ window
etch photoresist start x=10.05 y=-2.00
etch cont          x=10.85 y=-2.00
etch cont          x=10.85 y=0.80
etch done          x=10.05 y=0.80

implant arsenic dose=5.0e15 energy=60 tilt=0 pearson

strip photoresist

structure outfile=ldmos_04_01_nplus_sd_v4.str

# ------------------------------------------------------------
# Source/Drain activation anneal
#
# Paper:
#   Additional anneal
#   Total duration = 1.67 min
#   Temperature range = 700 ~ 1050 C
#
# ATHENA approximation:
#   1050 C, 1.67 min, N2
# ------------------------------------------------------------
method compress
d
go athena

# ============================================================
# Part 4. N+ Source/Drain and P+ Body
# Input:
#   ldmos_03_gate_ldd_fix_v3.str
# Output:
#   ldmos_final_figure2_clean_v4.str
#
# Purpose:
#   Add source/drain N+ and body P+ regions.
#   This version avoids thermal oxidation crash after spacer.
# ============================================================

init infile=ldmos_03_gate_ldd_fix_v3.str

# ------------------------------------------------------------
# Screen oxide before Source/Drain implant
#
# Paper:
#   Dry O2, 925 C, 20 min
#
# Practical ATHENA replacement:
#   Use thin deposited oxide instead of thermal oxidation.
#   This prevents mesh failure around LOCOS / poly / spacer.
# ------------------------------------------------------------
deposit oxide thick=0.02

structure outfile=ldmos_04_00_screen_oxide_v4.str

# ------------------------------------------------------------
# N+ Source / Drain implant
#
# Paper:
#   Arsenic dose = 5e15 cm-2
#   Energy = 60 keV
#   Pearson distribution
#
# Target:
#   Source N+ = x 0.70 ~ 1.45 um
#   NLDD tail remains between x 1.45 ~ 1.95 um
# ------------------------------------------------------------
deposit photoresist thick=1.20

# Source N+ window
etch photoresist start x=0.70 y=-2.00
etch cont          x=1.45 y=-2.00
etch cont          x=1.45 y=0.80
etch done          x=0.70 y=0.80

# Drain N+ window
etch photoresist start x=10.05 y=-2.00
etch cont          x=10.85 y=-2.00
etch cont          x=10.85 y=0.80
etch done          x=10.05 y=0.80

implant arsenic dose=5.0e15 energy=60 tilt=0 pearson

strip photoresist

structure outfile=ldmos_04_01_nplus_sd_v4.str

# ------------------------------------------------------------
# Source/Drain activation anneal
#
# Paper:
#   Additional anneal
#   Total duration = 1.67 min
#   Temperature range = 700 ~ 1050 C
#
# ATHENA approximation:
#   1050 C, 1.67 min, N2
# ------------------------------------------------------------
method compress

diffus time=1.67 temp=1050 nitrogen

structure outfile=ldmos_04_02_sd_anneal_v4.str

# ------------------------------------------------------------
# P+ Body implant
#
# Paper:
#   BF2 dose = 3e15 cm-2
#   Energy = 80 keV
#   Tilt = 7 deg
#
# If BF2 causes an implant model error in your ATHENA version,
# replace the BF2 line with:
#   implant boron dose=3.0e15 energy=40 tilt=7 pearson
# ------------------------------------------------------------
deposit photoresist thick=1.20

# P+ body contact window
etch photoresist start x=0.00 y=-2.00
etch cont          x=0.55 y=-2.00
etch cont          x=0.55 y=0.80
etch done          x=0.00 y=0.80

implant bf2 dose=3.0e15 energy=80 tilt=7 pearson

strip photoresist

structure outfile=ldmos_04_03_body_implant_before_anneal_v4.str

# ------------------------------------------------------------
# Body implant anneal
#
# Paper:
#   Additional anneal = 1.57 min
#
# ATHENA approximation:
#   1050 C, 1.57 min, N2
# ------------------------------------------------------------
diffus time=1.57 temp=1050 nitrogen

structure outfile=ldmos_04_04_body_anneal_v4.str

# ------------------------------------------------------------
# Remove only thin screen oxide on exposed contact regions
#
# Do NOT perform large contact etch.
# Do NOT define electrodes here.
# This file is for Figure 2 structure comparison.
# ------------------------------------------------------------
etch oxide dry thick=0.02

structure outfile=ldmos_final_figure2_clean_v4.str

tonyplot ldmos_04_01_nplus_sd_v4.str
tonyplot ldmos_final_figure2_clean_v4.str

quit

diffus time=1.67 temp=1050 nitrogen

structure outfile=ldmos_04_02_sd_anneal_v4.str

# ------------------------------------------------------------
# P+ Body implant
#
# Paper:
#   BF2 dose = 3e15 cm-2
#   Energy = 80 keV
#   Tilt = 7 deg
#
# If BF2 causes an implant model error in your ATHENA version,
# replace the BF2 line with:
#   implant boron dose=3.0e15 energy=40 tilt=7 pearson
# ------------------------------------------------------------
deposit photoresist thick=1.20

# P+ body contact window
etch photoresist start x=0.00 y=-2.00
etch cont          x=0.55 y=-2.00
etch cont          x=0.55 y=0.80
etch done          x=0.00 y=0.80

implant bf2 dose=3.0e15 energy=80 tilt=7 pearson

strip photoresist

structure outfile=ldmos_04_03_body_implant_before_anneal_v4.str

# ------------------------------------------------------------
# Body implant anneal
#
# Paper:
#   Additional anneal = 1.57 min
#
# ATHENA approximation:
#   1050 C, 1.57 min, N2
# ------------------------------------------------------------
diffus time=1.57 temp=1050 nitrogen

structure outfile=ldmos_04_04_body_anneal_v4.str

# ------------------------------------------------------------
# Remove only thin screen oxide on exposed contact regions
#
# Do NOT perform large contact etch.
# Do NOT define electrodes here.
# This file is for Figure 2 structure comparison.
# ------------------------------------------------------------
etch oxide dry thick=0.02

structure outfile=ldmos_final_figure2_clean_v4.str

tonyplot ldmos_04_01_nplus_sd_v4.str
tonyplot ldmos_final_figure2_clean_v4.str

quit
